# Configuración de salida
set terminal pngcairo size 1200,800 enhanced font 'Verdana,10'
set output 'comparativa_uniforme_OB.png'

# Títulos y estilos
set title "Búsqueda Lineal vs Binaria (Uniforme) - Operaciones Básicas"
set xlabel "Tamaño del Diccionario (N)"
set ylabel "Número medio de OBs"
set grid
set key left top box

# --- DEFINICIÓN DE FUNCIONES ---
# Lineal: O(N)
f_lin(x) = a_lin * x + b_lin
# Binaria: O(log N)
f_bin(x) = a_bin * log(x) + b_bin

# --- INICIALIZACIÓN DE VARIABLES (Vital para evitar errores) ---
a_lin = 0.5; b_lin = 0.0;
a_bin = 1.0; b_bin = 1.0;

# --- AJUSTE DE CURVAS (FIT) ---
# Ajustamos usando la columna 3 (Average_OB)
fit f_lin(x) 'lin_uniform.dat' using 1:3 via a_lin, b_lin
fit f_bin(x) 'bin_uniform.dat' using 1:3 via a_bin, b_bin

# --- GRÁFICA OB ---
plot 'lin_uniform.dat' using 1:3 title 'Lineal (Datos)' with lines lw 2 lc rgb "red", \
     f_lin(x) title 'Ajuste Lineal O(N)' with lines dt 2 lw 2 lc rgb "dark-red", \
     'bin_uniform.dat' using 1:3 title 'Binaria (Datos)' with lines lw 2 lc rgb "blue", \
     f_bin(x) title 'Ajuste Log O(log N)' with lines dt 2 lw 2 lc rgb "dark-blue"

# -------------------------------------------------------------------------
# --- GRÁFICA DE TIEMPO ---
set output 'comparativa_uniforme_Time.png'
set title "Búsqueda Lineal vs Binaria (Uniforme) - Tiempo Real"
set ylabel "Tiempo (s)"

# Reiniciamos variables con valores muy pequeños para el tiempo
a_lin_t = 0.000001; b_lin_t = 0.000000;
a_bin_t = 0.000001; b_bin_t = 0.000000;

# Definimos funciones para tiempo (mismas fórmulas, distintas variables)
ft_lin(x) = a_lin_t * x + b_lin_t
ft_bin(x) = a_bin_t * log(x) + b_bin_t

# Ajustamos usando la columna 2 (Time)
fit ft_lin(x) 'lin_uniform.dat' using 1:2 via a_lin_t, b_lin_t
fit ft_bin(x) 'bin_uniform.dat' using 1:2 via a_bin_t, b_bin_t

plot 'lin_uniform.dat' using 1:2 title 'Lineal Time' with lines lw 2 lc rgb "red", \
     ft_lin(x) title 'Ajuste Lineal' with lines dt 2 lw 2 lc rgb "dark-red", \
     'bin_uniform.dat' using 1:2 title 'Binaria Time' with lines lw 2 lc rgb "blue", \
     ft_bin(x) title 'Ajuste Log' with lines dt 2 lw 2 lc rgb "dark-blue"